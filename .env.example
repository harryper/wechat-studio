# 复制为 .env 并填入真实取值。.gitignore 只忽略 .env，本文件入库。
# 首次打开 Web 工作台且 webapp/_data/model-settings.json 不存在时，Web 会从本文件和 config.yaml 导入模型设置一次。
# 此后 Web 使用本机模型设置文件；下面的变量仍是 CLI/OpenClaw 持续使用的配置来源。

# ── 写作（首次 Web 导入；CLI/OpenClaw 持续使用。Anthropic Messages 兼容端点，三项必填）──
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=MiniMax-M3

# ── 配图（首次 Web 导入；CLI/OpenClaw 持续使用）────────────────────
# CLI/OpenClaw 用 config.yaml 里的 id 决定启用哪些供应商、什么顺序；未设置则用 config.yaml 声明顺序
IMAGE_PROVIDER_ORDER=cliproxy,seedream,minimax
CLIPROXY_IMAGE_API_KEY=
CLIPROXY_IMAGE_BASE_URL=http://127.0.0.1:8317/v1
ARK_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=

# ── 微信草稿 ──────────────────────────────────────────────────────
WECHAT_APPID=
WECHAT_SECRET=

# ── Web 工作台（登录和本机运行配置）───────────────────────────────
APP_PASSWORD=
APP_COOKIE_SECRET=
D1_API_URL=https://wechat-studio-data.harryperlau.workers.dev
XIAOHU_FORMAT_DIR=
