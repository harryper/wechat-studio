# Config with env vars (no secrets in git)
# config.yaml is committed — sensitive values use ${VAR:-default} syntax
.env
# Legacy D1 token file from old deployments; only on hosts that previously
# ran the Worker-backed version. Safe to delete locally — it is no longer
# referenced by the Web app.
.d1_api_token
style.yaml
history.yaml
playbook.md
corpus/
lessons/

# Optimized writing parameters (user runs loop to generate their own)
writing-config.yaml
optimization-results.tsv

# Generated output
output/
!output/.gitkeep

# Web UI runtime state
# webapp/_data/ holds history.json, topics.json, jobs/, workdirs/, model-settings.json
# The directory itself is git-ignored. Local Docker Compose mounts the host copy
# into the container so recreated containers keep the data.
webapp/_data/
webapp/_data/model-settings.json

# Exemplar library (user-specific content)
references/exemplars/*.md
references/exemplars/index.yaml

# Legacy client directories
clients/

# macOS
.DS_Store

# Legacy Wrangler local state from old deployments
.wrangler/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/*
!dist/openclaw/
build/

# Internal dev docs
docs/
CLAUDE.md
.superpowers/
.worktrees/

# IDE
.vscode/
.idea/
